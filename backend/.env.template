# Project settings
PROJECT_NAME="Healthcare Appointment Manager"
API_V1_STR="/api/v1"

# Database Connection
# Replace with your Supabase Transaction/Session pooler URL.
# Example: postgresql://postgres.xxxxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?sslmode=require"

# CORS Configuration (JSON-formatted list of allowed origins)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# JWT Configuration
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY="CHANGEME_SECRET_KEY_FOR_LOCAL_JWT_SIGNING_1234567890"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

